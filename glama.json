{
  "$schema": "https://glama.ai/mcp/schemas/server.json",
  "name": "pr-genius",
  "displayName": "PR Genius",
  "version": "1.3.0",
  "description": "Evidence-backed PR contribution advisor MCP — local-only, read-only, OKF v0.1 compliant. Tells agents which PRs NOT to open, based on real accepted/rejected PR histories across 12+ large open-source projects.",
  "longDescription": "pr-genius is a local-only, evidence-backed PR contribution advisor. It does NOT review code quality; instead it reviews contribution strategy (whether to open the PR at all).\n\nBuilt from real accepted/rejected PR histories of zsxh1990 (~50 PRs across astral-sh/uv, plastic-labs/honcho, qdrant, e2b, fastmcp, harbor, agentic-community, mongodb-js, sourcebot, future-agi, NousResearch/hermes-agent, openclaw/openclaw).\n\nKey features:\n- 58 repo profiles with maintainer vibe + AI policy + 17 agent_guidelines fields\n- 68+ anti-patterns (duplicate / out-of-scope / not-a-real-bug / etc.)\n- 11 maintainer policies (MisakaNet + planned coverage of other repos)\n- 552+ coach cases with 87% accuracy (predicted vs actual merge outcomes)\n- OKF v0.1 compliant knowledge bundle (Sudhakaran88/okf-conformance PASS)\n\nPositioning (NOT what this MCP does):\n- NOT a code reviewer (use CodeRabbit / Copilot for that)\n- NOT an auto-PR bot (use ContribAI for that)\n- NOT an issue triage (use Devin / Sweep for that)\n\nWhat this MCP DOES:\n- analyze_pr: structured signals + tier (low/medium/high) + checklist\n- coach_pr: pass/fail (Agent PR Dojo)\n- triage_pr: policy-aware verdict (pass/warn/reject/needs_preflight)\n- get_repo_profile: org/name repo profile\n- get_case_study: specific PR case study with rounds\n- list_open_prs: tracked open PRs\n- search_patterns: search anti-patterns + success-patterns\n- schema_info: OKF schema versions + enum values",
  "author": {
    "name": "zsxh1990",
    "email": "445655361@qq.com",
    "url": "https://github.com/zsxh1990/pr-genius"
  },
  "license": "MIT",
  "homepage": "https://github.com/zsxh1990/pr-genius",
  "repository": {
    "type": "git",
    "url": "https://github.com/zsxh1990/pr-genius.git"
  },
  "categories": [
    "developer-tools",
    "code-review",
    "git",
    "knowledge-base",
    "open-source"
  ],
  "tags": [
    "pr-contribution",
    "anti-pattern",
    "maintainer-policy",
    "okf",
    "knowledge-bundle",
    "evidence-driven",
    "read-only",
    "local-only"
  ],
  "iconUrl": "https://raw.githubusercontent.com/zsxh1990/pr-genius/main/docs/assets/pr-genius-icon.png",
  "transport": {
    "type": "stdio",
    "command": "python",
    "args": [
      "-m",
      "prgenius",
      "mcp",
      "serve"
    ],
    "env": {}
  },
  "docker": {
    "image": "pr-genius:1.3.0",
    "dockerfile": "Dockerfile"
  },
  "tools": [
    {
      "name": "analyze_pr",
      "description": "Detailed PR analysis with signals and checklist. Use analyze_pr for deep analysis with improvement suggestions, coach_pr for quick pass/fail.",
      "inputSchema": {
        "type": "object",
        "required": [
          "title",
          "repo"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "PR title (e.g. \"feat: add search endpoint\")"
          },
          "repo": {
            "type": "string",
            "description": "Target repo in org/name format (e.g. \"encode/httpx\")"
          },
          "body": {
            "type": "string",
            "description": "PR body/description text"
          },
          "description": {
            "type": "string",
            "description": "Extended description"
          },
          "author": {
            "type": "string",
            "description": "PR author username"
          },
          "author_association": {
            "type": "string",
            "description": "Author association (NONE/CONTRIBUTOR/COLLABORATOR/MEMBER/OWNER)"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "PR labels"
          },
          "star_count": {
            "type": "integer",
            "description": "Repository star count (0 = unknown)"
          },
          "repo_merge_rate": {
            "type": "number",
            "description": "External PR merge rate 0.0-1.0"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      }
    },
    {
      "name": "coach_pr",
      "description": "Quick pass/fail gate before opening a PR. Use coach_pr for go/no-go decision, analyze_pr for detailed analysis with signals.",
      "inputSchema": {
        "type": "object",
        "required": [
          "title",
          "repo"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "PR title"
          },
          "repo": {
            "type": "string",
            "description": "Target repo (org/name)"
          },
          "body": {
            "type": "string",
            "description": "PR body/description"
          },
          "description": {
            "type": "string",
            "description": "Extended description"
          },
          "author": {
            "type": "string",
            "description": "PR author username"
          },
          "author_association": {
            "type": "string",
            "description": "Author association"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "PR labels"
          },
          "star_count": {
            "type": "integer",
            "description": "Repo star count"
          },
          "repo_merge_rate": {
            "type": "number",
            "description": "External merge rate"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      }
    },
    {
      "name": "triage_pr",
      "description": "Policy-aware PR screening against maintainer rules. Returns verdict (pass/warn/reject) with violations and recommended action.",
      "inputSchema": {
        "type": "object",
        "required": [
          "title",
          "repo"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "PR title"
          },
          "repo": {
            "type": "string",
            "description": "Target repo (org/name)"
          },
          "body": {
            "type": "string",
            "description": "PR body/description"
          },
          "diff_stat": {
            "type": "string",
            "description": "git diff --stat output"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "PR labels"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      }
    },
    {
      "name": "get_repo_profile",
      "description": "Get repository profile with 17 agent_guidelines fields: ai_policy, maintainer_vibe, merge_rate, close_keywords, etc.",
      "inputSchema": {
        "type": "object",
        "required": [
          "repo"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "description": "Repository in org/name format"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      }
    },
    {
      "name": "list_open_prs",
      "description": "List all open PR case studies in the knowledge base. Returns PRs with current status.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      }
    },
    {
      "name": "get_case_study",
      "description": "Get a specific PR case study with full details and round-by-round interaction history.",
      "inputSchema": {
        "type": "object",
        "required": [
          "repo",
          "pr_number"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "description": "Repository (org/name)"
          },
          "pr_number": {
            "type": "integer",
            "description": "PR number"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      }
    },
    {
      "name": "search_patterns",
      "description": "Search anti-patterns and success-patterns by keyword. Use to find relevant patterns before submitting a PR.",
      "inputSchema": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "description": "Search keyword (e.g. \"duplicate PR\", \"missing tests\")"
          },
          "pattern_type": {
            "type": "string",
            "description": "\"all\" / \"anti-pattern\" / \"success-pattern\""
          },
          "limit": {
            "type": "integer",
            "description": "Max results (default 10)"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      }
    },
    {
      "name": "schema_info",
      "description": "Return supported OKF schema versions and enum values.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      }
    }
  ],
  "safety": {
    "networkAccess": "none",
    "auth": "none",
    "dataWriteback": false,
    "dataEgress": false,
    "filesystemAccess": "read-only (knowledge bundle)",
    "environmentVariables": []
  },
  "installation": {
    "claudeCode": {
      "config": "~/.claude/mcp.json",
      "snippet": "{\n  \"mcpServers\": {\n    \"pr-genius\": {\n      \"command\": \"python\",\n      \"args\": [\"-m\", \"prgenius\", \"mcp\", \"serve\"]\n    }\n  }\n}"
    },
    "cursor": {
      "config": "~/.cursor/mcp.json",
      "snippet": "{\n  \"mcpServers\": {\n    \"pr-genius\": {\n      \"command\": \"python\",\n      \"args\": [\"-m\", \"prgenius\", \"mcp\", \"serve\"]\n    }\n  }\n}"
    },
    "cline": {
      "config": "~/.config/Code/User/globalStorage/saoudrizwan.claude-dev/settings/cline_mcp_settings.json",
      "snippet": "{\n  \"mcpServers\": {\n    \"pr-genius\": {\n      \"command\": \"python\",\n      \"args\": [\"-m\", \"prgenius\", \"mcp\", \"serve\"]\n    }\n  }\n}"
    },
    "docker": "docker run --rm -i ghcr.io/zsxh1990/pr-genius:1.3.0"
  }
}